{
  "name": "blockchainiq-langchain-brief",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Guarded LangChain tools for the Blockchain IQ x402 API: the market brief, or any resource in the live catalogue within owner-set limits.",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "test",
    "VALIDATION.md",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "CHANGES.md",
    "TESTS.md",
    "UPSTREAM-README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "quote": "node scripts/quote.js",
    "wallet": "node scripts/owner-wallet-server.js",
    "check": "node --check src/index.js && node --check src/sdk-payment.js && node --check src/catalog.js && node --test",
    "brief": "node scripts/run.js",
    "catalog": "node scripts/catalog.js",
    "get": "node scripts/get.js"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "overrides": {
    "@x402/core": {
      "zod": "4.6.7"
    },
    "@x402/evm": {
      "zod": "4.6.7"
    }
  }
}
